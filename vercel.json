{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp-oauth?action=resource-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/mcp-oauth?action=resource-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp-oauth?action=as-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/api/mcp",
      "destination": "/api/mcp-oauth?action=as-metadata"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/mcp-oauth?action=as-metadata"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/mcp-oauth?action=register"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/mcp-oauth?action=authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/mcp-oauth?action=token"
    },
    {
      "source": "/oauth/revoke",
      "destination": "/api/mcp-oauth?action=revoke"
    },
    {
      "source": "/mcp/:scope",
      "destination": "/api/mcp?scope=:scope"
    },
    {
      "source": "/r/:code",
      "destination": "/ambassador-lead"
    },
    {
      "source": "/",
      "destination": "/login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://*.onesignal.com https://onesignal.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://cdn.onesignal.com https://onesignal.com https://api.onesignal.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.onesignal.com https://onesignal.com; font-src 'self' https://fonts.gstatic.com https://cdn.onesignal.com https://onesignal.com; connect-src 'self' https://*.supabase.co https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.onesignal.com https://onesignal.com https://*.onesignal.com https://api.onesignal.com wss://*.onesignal.com; img-src 'self' data: https:; worker-src 'self' blob: https://cdn.onesignal.com https://onesignal.com; frame-src https://onesignal.com https://api.onesignal.com https://docs.google.com https://drive.google.com;"
        }
      ]
    },
    {
      "source": "/diventa-ambassador",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/diventa-ambassador.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "buildCommand": "echo skip",
  "outputDirectory": ".",
  "installCommand": "echo skip",
  "crons": [
    {
      "path": "/api/trigger-notifications",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/trigger-employee-report",
      "schedule": "0 16 * * *"
    }
  ]
}
